UX_MEASURE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SITE_ID=

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=

POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# Session replay dogfood - loopback owner runtime only (gate 9 signed for dogfood scope).
# The read/player routes additionally require NODE_ENV=development.
# SITE_KEY is the public write key (>=16 chars, e.g. `openssl rand -hex 24`);
# set the same value in both vars so the workspace recorder can send to ingest.
UX_MEASURE_REPLAY_ENABLED=false
UX_MEASURE_REPLAY_SITE_KEY=
NEXT_PUBLIC_UX_MEASURE_REPLAY_SITE_KEY=
# Optional comma-separated loopback origins (default: http://127.0.0.1:3000,http://localhost:3000)
# UX_MEASURE_REPLAY_ALLOWED_ORIGINS=
